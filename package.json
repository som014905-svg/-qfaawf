{
  "name": "luau-deobf-engine",
  "version": "6.1.0",
  "description": "Luau/Lua deobfuscation engine with corpus-driven detection, Luraph VM decoding, IronBrew/MoonSec/MoonVeil/Prometheus, modern Clyde/Dava static VM patterns, static cleanup, and regression harnesses. — X10-DEEP Universal cross-family structural recovery and dispatcher flattening (v6.1).",
  "type": "module",
  "private": true,
  "scripts": {
    "deobf": "bun run src/cli.ts",
    "test": "bun run test-samples/run-tests.ts",
    "setup:vm": "bun add luau-web wasmoon",
    "typecheck": "tsc --noEmit",
    "deobf:node": "tsx src/cli.ts",
    "test:node": "tsx test-samples/run-tests.ts",
    "test:regression": "bun run test-samples/regression.ts",
    "test:static": "tsx test-samples/static-resolve.ts",
    "test:structural": "tsx test-samples/v590-structural.ts",
    "test:corpus": "bun run test-samples/deobf-batch.ts",
    "test:corpus:detect": "bun run test-samples/detect-batch.ts",
    "corpus:update": "bun run scripts-update-corpus.ts",
    "test:function-v600": "tsx test-samples/function-level-v600.ts"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "bun-types": "^1.2.21",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "luau-web": "^1.4.0",
    "wasmoon": "^1.16.0"
  }
}
